rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidPlaylist(data) {
      return hasRequiredFields([
          'id', 'title', 'subtitle', 'description', 'artwork',
          'previewArtworks', 'songCount', 'ownerId', 'ownerName',
          'isPublic', 'songsJson', 'createdAt', 'updatedAt'
        ]) &&
        hasOnlyAllowedFields([
          'id', 'title', 'subtitle', 'description', 'artwork',
          'previewArtworks', 'songCount', 'ownerId', 'ownerName',
          'isPublic', 'songsJson', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 150 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.subtitle is string && data.subtitle.size() <= 300 &&
        data.description is string && data.description.size() <= 1000 &&
        data.artwork is string && data.artwork.size() <= 1500 &&
        data.previewArtworks is list && data.previewArtworks.size() <= 10 &&
        data.songCount is int && data.songCount >= 0 && data.songCount <= 5000 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerName is string && data.ownerName.size() <= 150 &&
        data.isPublic is bool &&
        data.songsJson is string && data.songsJson.size() <= 500000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isAuthenticated() &&
        isValidPlaylist(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() &&
        isDocOwner() &&
        isValidPlaylist(request.resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && isDocOwner();
    }
  }
}
